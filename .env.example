# Roboflow API Key (for Roboflow universe models and workflows)
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Google Gemini / AI Studio API Key (used for VLM object detection in workflows or direct API)
# Note: For Google AI Studio (API key AIzaSy...), only this key is needed (no project number required).
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# OpenAI API Key (required for GPT-6.1 Sol object detection via Roboflow Workflows or direct API)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter Unified API Key (single key to access Google Gemini, OpenAI GPT, Anthropic Claude, Qwen, Mistral)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Google Cloud Project ID / Number (only required if connecting via Vertex AI enterprise)
# GOOGLE_CLOUD_PROJECT=your_project_id_or_number

# HuggingFace Token (optional)
# HF_TOKEN=your_hf_token_here

# Local Segment Anything Models (SAM) configuration
CORE_MODEL_SAM2_ENABLED=False
CORE_MODEL_SAM3_ENABLED=False

